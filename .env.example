# ---------------------------------------------------------------- required

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/vero-goods

# Signs session cookies. Must be at least 32 characters. The app refuses to
# start a session without it — there is no insecure fallback.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin portal credential. Prefer the hash; generate both with:
#   node scripts/hash-password.mjs "<password>"
ADMIN_PASSWORD_HASH=
# Plaintext fallback for local development only. There is NO default password.
# ADMIN_PASSWORD=

# Absolute public origin, used for emails, canonical URLs, OG tags and sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- payments

# Leave both blank for local development. When they are absent, online payment
# is disabled unless RAZORPAY_SANDBOX_SIMULATION is explicitly turned on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret from the Razorpay dashboard. Required for payments to settle
# reliably — the browser callback alone loses orders when a customer closes the
# tab after paying.
#   URL:    <NEXT_PUBLIC_APP_URL>/api/payments/razorpay/webhook
#   Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Local-only payment simulation. Ignored in production and ignored whenever
# real Razorpay keys are set.
RAZORPAY_SANDBOX_SIMULATION=true

# ---------------------------------------------------------------- email

# Transactional email (OTP codes, receipts, status updates) over Gmail SMTP.
# Without both values, messages are logged to the server console instead of
# sent — the app stays usable end to end before mail is configured.
SMTP_EMAIL_ADDRESS=
SMTP_APP_PASSWORD=
SMTP_PORT=465
SUPPORT_EMAIL=support@verogoods.in

# --------------------------------------------------------------- discord

# Admin order alerts. Server Settings -> Integrations -> Webhooks -> New
# Webhook, then Copy Webhook URL. Leave blank and no alerts are sent.
#
# The URL is the only credential — anyone holding it can post to the channel,
# and it cannot be rotated except by deleting the webhook. Alerts carry the
# customer's name, phone, email and full delivery address, so the channel must
# be private to people who already have admin access.
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------- sms

# Login codes for customers who sign in with a mobile number. Leave
# SMS_PROVIDER blank and codes are printed to the server terminal instead.
#   twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
#   msg91  -> MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_DLT_TEMPLATE_ID
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# --------------------------------------------------------- google sign-in

# OAuth client id from the Google Cloud console (Web application). Add your
# origin to "Authorised JavaScript origins". Both variables hold the SAME id:
# the public one renders the button, the server one verifies the token.
# Leave blank and the Google button is not rendered at all.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------ media uploads

# Cloudinary, used for product images and videos in the admin portal. The
# browser uploads straight to Cloudinary using a signature this server issues,
# so the secret never leaves the server and large videos never pass through it.
# Leave blank and the upload button reports that uploads are not configured —
# pasting supplier CDN URLs keeps working either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------- commercial rules (paise)

# All values are integer paise. 8000 = ₹80.
SHIPPING_FLAT_MINOR=8000
FREE_SHIPPING_THRESHOLD_MINOR=200000
COD_FEE_MINOR=2000
COD_MAX_ORDER_MINOR=2000000
DISCORD_WEBHOOK_URL=""

